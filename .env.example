# Copy to .env and set local values. Never commit .env.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_NAME=secure_document_db
DATABASE_USER=postgres
DATABASE_PASSWORD=your_local_password_here
DATABASE_HOST=localhost
DATABASE_PORT=5432
# Token lifetimes are intentionally short and can be tightened per deployment.
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=1
